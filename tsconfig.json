{
  "compileOnSave": false,
  "compilerOptions": {
    "baseUrl": "./",
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    "declaration": false,
    "experimentalDecorators": true,
    "moduleResolution": "node",
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve",
    "lib": ["es2018", "dom"],
    "paths": {
      "ng-shield-editor": ["dist/ng-shield-editor/ng-shield-editor", "dist/ng-shield-editor"]
    }
  },
  "angularCompilerOptions": {
    "preserveWhitespaces": false,
    "strictTemplates": true,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true
  }
}
